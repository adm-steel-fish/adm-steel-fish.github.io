rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /articles/{articleId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.datetime is string;
      allow update, delete: if false;
    }

    // Player mail is only touched by netlify/functions/mail-api.mjs, which
    // signs in as the mail server's Firebase Auth user. Nobody else, players
    // included, gets any access; the function checks players itself.
    match /{collection}/{docId} {
      allow read, write: if collection in ['mail_players', 'mail_friend_codes', 'mail_letters',
                                           'mail_reports', 'mail_register_ips']
                         && request.auth != null
                         && request.auth.uid == 'Q6xv78gLDQgECahgg6BZtrCVl202';
    }
  }
}
